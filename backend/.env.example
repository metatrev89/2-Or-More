# ── 2+ backend environment ────────────────────────────────────────────
# Copy to .env and fill in. With all PROVIDER_* set to "mock", the entire
# pipeline runs locally with zero external accounts.

# Provider selection per AI job: mock | live
PROVIDER_INTAKE_LLM=mock        # live -> Muse Spark 1.1 (Meta Model API)
PROVIDER_REWRITE_LLM=mock       # live -> DeepSeek V4 Flash via US host
PROVIDER_TTS=mock               # live -> Fish Audio s2-pro
PROVIDER_IMAGE=mock             # live -> FLUX.2 via fal
PROVIDER_VIDEO=mock             # live -> LTX-2.3 (or Wan via fal — see VIDEO_VENDOR)
PROVIDER_STORAGE=local          # local | r2

# ── Supabase (auth + Postgres) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # worker only — never ship to client

# ── LLM vendors ──
META_MODEL_API_KEY=             # Muse Spark 1.1 — https://ai.meta.com (public preview)
META_MODEL_API_BASE=https://api.meta.ai/v1   # VERIFY against Meta docs before production
ANTHROPIC_API_KEY=              # Claude fallback for intake
TOGETHER_API_KEY=               # DeepSeek/Qwen via US host

# ── Media vendors ──
FISH_AUDIO_API_KEY=             # https://fish.audio — TTS + voice clone
FAL_API_KEY=                    # https://fal.ai — FLUX.2 images, Wan video
LTX_API_KEY=                    # https://console.ltx.video — LTX-2.3 video
VIDEO_VENDOR=ltx                # ltx | wan  (bake-off winner goes here)

# ── Cloudflare R2 (media storage; zero egress) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=twoplus-media

# ── RevenueCat (subscriptions / trial state) ──
REVENUECAT_WEBHOOK_SECRET=

# ── Local dev ──
LOCAL_MEDIA_DIR=./.media        # where PROVIDER_STORAGE=local writes files
PORT=8787
