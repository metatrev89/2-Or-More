# Supabase (Stage 2) — copy to .env and fill from your Supabase project settings.
# Project Settings → API: Project URL + anon/public key.
# These are publishable values (security = RLS), but .env stays untracked anyway.
# The service_role key belongs in backend/.env ONLY — never here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
